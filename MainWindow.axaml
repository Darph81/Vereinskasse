<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Vereinskasse.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Vereinskasse.MainWindow"
        Title="Vereinskasse"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F0F5F9">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Border Grid.Row="0" Background="#1D82C6" Padding="24,14">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="KASSENSYSTEM VEREINS-EVENT"
                           Foreground="White" FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ClockText}"
                           Foreground="White" FontSize="18"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" ColumnDefinitions="3*,360" Margin="16">

            <!-- Product buttons, loaded from Preisliste.xlsx -->
            <Grid Grid.Column="0" Margin="0,0,12,0" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="{Binding LoadError}"
                           Foreground="Crimson" FontWeight="Bold" Margin="4,0,4,8"
                           TextWrapping="Wrap"
                           IsVisible="{Binding LoadError, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6" Background="White" CornerRadius="10"
                                        BorderBrush="#D5E4EE" BorderThickness="1" MinWidth="220"
                                        VerticalAlignment="Top">
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Top" Background="{Binding HeaderBackground}"
                                                CornerRadius="10,10,0,0" Padding="0,14">
                                            <TextBlock Text="{Binding Name}" Foreground="White"
                                                       FontWeight="Bold" FontSize="16"
                                                       HorizontalAlignment="Center" />
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Products}" Margin="8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,4" Padding="12,14"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Background="{Binding Background}"
                                                            BorderBrush="#B9D6EA" BorderThickness="1"
                                                            CornerRadius="6"
                                                            Command="{Binding AddCommand}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       FontSize="15" TextAlignment="Center"
                                                                       TextWrapping="Wrap" Foreground="#1A1A1A" />
                                                            <TextBlock Text="{Binding PriceText}" FontSize="14"
                                                                       Foreground="#333333" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Order / payment panel -->
            <Border Grid.Column="1" Background="White" CornerRadius="10"
                    BorderBrush="#D5E4EE" BorderThickness="1" Padding="14">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">

                    <TextBlock Grid.Row="0" Text="AKTUELLE BESTELLUNG" FontWeight="Bold"
                               FontSize="16" Margin="0,0,0,10" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OrderLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4">
                                        <TextBlock Grid.Column="0" Text="{Binding Quantity, StringFormat={}{0}x}"
                                                   FontWeight="SemiBold" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding LineTotalText}"
                                                   Margin="8,0" FontWeight="SemiBold" />
                                        <Button Grid.Column="3" Content="➖" Padding="6,2"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="Crimson"
                                                Command="{Binding RemoveCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Gesamt / Gegeben / Rückgeld block -->
                    <Border Grid.Row="2" BorderBrush="#D5E4EE" BorderThickness="0,1,0,0"
                            Margin="0,8,0,0" Padding="0,10,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Gesamt:" FontWeight="Bold" FontSize="18" />
                            <TextBlock Grid.Column="1" Text="{Binding TotalText}"
                                       FontWeight="Bold" FontSize="18" Foreground="#2E8B45" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                        <TextBlock Grid.Column="0" Text="Gegeben: €" VerticalAlignment="Center"
                                   FontSize="16" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Text="{Binding GegebenText}"
                                  FontSize="18" Padding="10,10" IsReadOnly="True" />
                    </Grid>

                    <Separator Grid.Row="4" Margin="0,10" Background="#9FB7C8" Height="2" />

                    <TextBlock Grid.Row="5" Text="{Binding RueckgeldText, StringFormat=Rückgeld: {0}}"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <!-- Numpad: every button fills its cell equally for easy touch hits -->
                    <Grid Grid.Row="6" Height="320" Margin="0,0,0,10"
                          ColumnDefinitions="*,*,*" RowDefinitions="*,*,*,*,*">
                        <Button Grid.Row="0" Grid.Column="0" Content="7" Classes="numpad"
                                Command="{Binding DigitCommand}" CommandParameter="7" />
                        <Button Grid.Row="0" Grid.Column="1" Content="8" Classes="numpad"
                                Command="{Binding DigitCommand}" CommandParameter="8" />
                        <Button Grid.Row="0" Grid.Column="2" Content="9" Classes="numpad"
                                Command="{Binding DigitCommand}" CommandParameter="9" />

                        <Button Grid.Row="1" Grid.Column="0" Content="4" Classes="numpad"
                                Command="{Binding DigitCommand}" CommandParameter="4" />
                        <Button Grid.Row="1" Grid.Column="1" Content="5" Classes="numpad"
                                Command="{Binding DigitCommand}" CommandParameter="5" />
                        <Button Grid.Row="1" Grid.Column="2" Content="6" Classes="numpad"
                                Command="{Binding DigitCommand}" CommandParameter="6" />

                        <Button Grid.Row="2" Grid.Column="0" Content="1" Classes="numpad"
                                Command="{Binding DigitCommand}" CommandParameter="1" />
                        <Button Grid.Row="2" Grid.Column="1" Content="2" Classes="numpad"
                                Command="{Binding DigitCommand}" CommandParameter="2" />
                        <Button Grid.Row="2" Grid.Column="2" Content="3" Classes="numpad"
                                Command="{Binding DigitCommand}" CommandParameter="3" />

                        <Button Grid.Row="3" Grid.Column="0" Content="," Classes="numpad"
                                Command="{Binding DigitCommand}" CommandParameter="," />
                        <Button Grid.Row="3" Grid.Column="1" Content="0" Classes="numpad"
                                Command="{Binding DigitCommand}" CommandParameter="0" />
                        <Button Grid.Row="3" Grid.Column="2" Content="⌫" Classes="numpadMuted"
                                Command="{Binding BackspaceCommand}" />

                        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Content="C" Classes="numpadClear"
                                Command="{Binding ClearGegebenCommand}" />
                    </Grid>

                    <!-- Payment actions -->
                    <Grid Grid.Row="7" ColumnDefinitions="*,*">
                        <Button Grid.Column="0" Margin="0,0,4,0"
                                Padding="4,14" Background="#3DA35D" FontWeight="Bold"
                                HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                                Command="{Binding CompletePaymentCommand}">
                            <TextBlock Text="ABSCHLIESSEN" Foreground="White"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </Button>
                        <Button Grid.Column="1" Content="LÖSCHEN" Margin="4,0,0,0"
                                Padding="8,14" Background="#D9534F" Foreground="White" FontWeight="Bold"
                                HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                                Command="{Binding ClearOrderCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>

    <Window.Styles>
        <Style Selector="Button.numpad, Button.numpadMuted, Button.numpadClear">
            <Setter Property="Margin" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.numpad">
            <Setter Property="Background" Value="#EAF3FB" />
            <Setter Property="Foreground" Value="#1A1A1A" />
        </Style>
        <Style Selector="Button.numpadMuted">
            <Setter Property="Background" Value="#DCE6ED" />
            <Setter Property="Foreground" Value="#1A1A1A" />
        </Style>
        <Style Selector="Button.numpadClear">
            <Setter Property="Background" Value="#D9534F" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>
</Window>
